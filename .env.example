# Copy to .env next to compose.yaml and adjust before running `docker compose up`.

POSTGRES_DB=qeymatban
POSTGRES_USER=qeymatban
POSTGRES_PASSWORD=change-me-in-production

# Comma-separated keys. If set, the dashboard must use the same value in QEYMATBAN_API_KEY.
QEYMATBAN_API_KEYS=
QEYMATBAN_API_KEY=

QEYMATBAN_CORS_ORIGINS=http://localhost:3000
BACKEND_PORT=8000
FRONTEND_PORT=3000
