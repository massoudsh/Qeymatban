# Copy to .env next to compose.yaml and adjust before running `docker compose up`.

POSTGRES_DB=qeymatban
POSTGRES_USER=qeymatban
POSTGRES_PASSWORD=change-me-in-production

# Comma-separated keys. If set, the dashboard must use the same value in QEYMATBAN_API_KEY.
QEYMATBAN_API_KEYS=
QEYMATBAN_API_KEY=

QEYMATBAN_CORS_ORIGINS=http://localhost:3000
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Registry mirrors. Leave these commented to use Docker Hub directly; uncomment
# and adjust when registry-1.docker.io is unreachable from your network.
# POSTGRES_IMAGE=mirror.example/postgres:16
# PYTHON_IMAGE=mirror.example/python:3.12-slim
# NODE_IMAGE=mirror.example/node:22-alpine
# POSTGIS_IMAGE=mirror.example/postgis/postgis:16-3.5
# PIP_INDEX_URL=https://mirror.example/pypi/simple
